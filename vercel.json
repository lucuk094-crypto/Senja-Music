{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/yt/feed",
      "dest": "/api/feed.ts"
    },
    {
      "src": "/api/yt/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/yt/lyrics",
      "dest": "/api/lyrics.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/(.*\\..+)",
      "dest": "/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ]
}
