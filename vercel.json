{
  "version": 2,
  "routes": [
    {
      "src": "/api/yt/feed",
      "dest": "/api/feed.ts"
    },
    {
      "src": "/api/yt/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/yt/lyrics",
      "dest": "/api/lyrics.ts"
    },
    {
      "src": "/api/_config",
      "dest": "/api/_config.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/(.*\\..+)",
      "dest": "/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite"
}
